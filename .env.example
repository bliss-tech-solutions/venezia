# Live domain, no trailing slash. Used for canonical URLs, sitemap.xml,
# robots.txt, structured data and share-image URLs.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Google Search Console → Settings → Ownership verification → HTML tag:
# paste only the content="..." value here.
NEXT_PUBLIC_GSC_VERIFICATION=

# Set to 1 on staging / preview deployments to keep them out of search results.
NEXT_PUBLIC_NOINDEX=
